{
  "name": "gridrisk-atlas",
  "version": "3.11.1",
  "description": "Satellite Wildfire & Grid Risk Intelligence for Türkiye, Spain, France, Portugal, Italy and Greece.",
  "homepage": "https://gridriskatlas.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/murathany90/gridrisk-atlas.git"
  },
  "bugs": {
    "url": "https://github.com/murathany90/gridrisk-atlas/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node tests.mjs && python -m unittest discover -s tests -p test_*.py",
    "test:python": "python -m unittest discover -s tests -p test_*.py",
    "build:grid": "python tools/build_country_grid.py --country EU",
    "validate:grid": "python tools/build_country_grid.py --country ALL --validate-runtime",
    "report:sizes": "node tools/report_runtime_sizes.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
